[flake8]
# Matches Black's configured line length in pyproject.toml, with headroom.
max-line-length = 120
# E203  slice notation spacing, conflicts with Black
# W503  line break before binary operator, conflicts with Black
# E221  multiple spaces before operator — intentional column alignment
# E251  spaces around keyword equals — intentional alignment in multi-line calls
# E272  multiple spaces before keyword — same as E221
extend-ignore = E203, W503, E221, E251, E272
exclude =
    .git,
    __pycache__,
    .venv,
    quantenv
