# Python
__pycache__/
*.pyc

# Tests
.pytest_cache/
.coverage

# Data and artifacts — all generated/downloaded; recreated by the pipeline
# Excluding the *contents* rather than the directory itself, because git will
# not descend into an excluded directory and so cannot re-include anything
# inside one — "/data/" would make the negation below silently do nothing.
/data/*
/artifacts/

# Derived research artifacts. Each sits inside whatever produces it, so what is
# scratch is obvious from the path rather than from this file.
#
#   poster/exports   the notebooks' full-resolution figure exports. The small
#                    subset the board actually places is published into
#                    poster/assets by `make poster`, and that subset is tracked —
#                    a clone cannot rebuild these, because the store the notebooks
#                    read is 18 GB and is not in the repository.
#   notebooks/_digest        the digest and its extracted charts, `make digest`
#   notebooks/_outputs       handoffs between notebooks, e.g. nb04 -> nb09
#   notebooks/robustness/_outputs   CSVs and pickles from the robustness scripts
/research/poster/exports/
/research/notebooks/_digest/
/research/notebooks/_outputs/
/research/notebooks/robustness/_outputs/

# Rendered boards — 250 KB of binary per revision, and `make poster` remakes
# them in seconds. The .typ layout source is the artifact under version control.
/research/poster/*.pdf
/research/poster/*.png

# ...except hand-researched reference data, the one thing here no pipeline can
# recreate. The energy-capacity worksheet is read off operator pages and press
# releases by a person; losing it to a gitignore would mean doing that twice.
!/data/reference/

# Local config — gitignored; *.example files are the committed templates
.env
.env.local
configs/config.yaml

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/*.log
