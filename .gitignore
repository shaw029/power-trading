# Python
__pycache__/
*.pyc

# Tests
.pytest_cache/
.coverage

# Data and artifacts — all generated/downloaded; recreated by the pipeline
/data/
/artifacts/

# ...except hand-researched reference data, which is the one thing here no
# pipeline can recreate. The energy-capacity worksheet is read off operator
# pages and press releases by a person; losing it to a gitignore would mean
# doing that work twice.
!/data/reference/
!/data/reference/**

# Local config — gitignored; *.example files are the committed templates
.env
.env.local
configs/config.yaml

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/*.log
