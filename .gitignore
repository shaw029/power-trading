# Python
__pycache__/
*.pyc

# Tests
.pytest_cache/
.coverage

# Data and artifacts — all generated/downloaded; recreated by the pipeline
# Excluding the *contents* rather than the directory itself, because git will
# not descend into an excluded directory and so cannot re-include anything
# inside one — "/data/" would make the negation below silently do nothing.
/data/*
/artifacts/

# Research figure exports and analysis outputs. Both are derived, both are
# rebuilt by re-running the notebook that owns them, and neither is reproducible
# from a clone — the store those notebooks read is 18 GB and is not in the
# repository. So the small subset the poster actually places is published into
# research/poster/assets by `make poster` and tracked there, and the bulk here
# is not. That subset is derived by reading the .typ sources, so a board that
# gains a panel picks it up rather than breaking for the next person to clone.
/research/figures/
/research/outputs/

# Rendered boards — 250 KB of binary per revision, and `make poster` remakes
# them in seconds. The .typ layout source is the artifact under version control.
/research/poster/*.pdf
/research/poster/*.png

# ...except hand-researched reference data, the one thing here no pipeline can
# recreate. The energy-capacity worksheet is read off operator pages and press
# releases by a person; losing it to a gitignore would mean doing that twice.
!/data/reference/

# Local config — gitignored; *.example files are the committed templates
.env
.env.local
configs/config.yaml

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/*.log
